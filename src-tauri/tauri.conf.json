{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "下班工具箱",
  "version": "1.2.0",
  "identifier": "fun.bbts.eduassist",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "if exist .\\pydist\\main.dist (xcopy /E /I /Y .\\pydist\\main.dist .\\src-tauri\\core && pnpm build) else (echo Error: Python build not found & exit /b 1)",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "下班工具箱",
        "width": 1080,
        "height": 720,
        "resizable": false,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "resources": {
      "./core": "core"
    }
  }
}
